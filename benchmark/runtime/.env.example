# Hugging Face API Key (required for QwQ, DeepSeek-R1, Qwen3)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# RunPod Pod — shared API key
RUNPOD_API_KEY=your_runpod_api_key_here

# GPT-OSS-120B endpoint (RunPod pod proxy URL)
GPT_OSS_API_KEY=your_runpod_api_key_here   # alias kept for backward compat
RUNPOD_GPT_OSS_120B_ENDPOINT=https://<pod-id>-8000.proxy.runpod.net/v1/chat/completions

# GLM-4.7-Flash endpoint (same pod, different vLLM instance)
RUNPOD_GLM47_FLASH_ENDPOINT=https://<pod-id>-8000.proxy.runpod.net/v1/chat/completions

# Pod SSH (for run_pod_pipeline.sh)
# POD_HOST=<pod-id>-22.proxy.runpod.net
# POD_SSH_KEY=~/.ssh/runpod

# Optional: Hugging Face cache directory
# HF_HOME=/path/to/cache
